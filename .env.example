# 复制为 .env 后按需修改：cp .env.example .env
# 基建由 ../002_infrastructure 提供（infra-postgres / infra-redis）。
# postgres 超管密码见 002 的 .env；pos_app 角色密码本项目自管（见 README 建库步骤）。

# --- server ---
APP_HOST=127.0.0.1
APP_PORT=8080
RUST_LOG=info,sqlx=warn

# --- database (共享 postgres 内的独立库 pos) ---
DATABASE_URL=postgres://pos_app:pos_app@localhost:5432/pos
DB_MAX_CONNECTIONS=20
DB_ACQUIRE_TIMEOUT_SECS=5

# --- redis (session / 限流 / 缓存)；dev 无密码 ---
REDIS_URL=redis://localhost:6379

# --- auth ---
SESSION_TTL_SECS=43200
SESSION_COOKIE_NAME=pos_sid

# --- cors (前端来源白名单，逗号分隔) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- clients ---
# pos-console / platform-admin 读这个连后端
PUBLIC_API_URL=http://localhost:8080
